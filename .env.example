# SoulClaw local development environment.
# Copy to `.env` and adjust only what you need.

# ---- Server ----
SOULCLAW_APP_NAME=SoulClaw
SOULCLAW_ENVIRONMENT=development
SOULCLAW_HOST=127.0.0.1
SOULCLAW_PORT=8020
SOULCLAW_LOG_LEVEL=INFO
SOULCLAW_AUTO_MIGRATE=true
SOULCLAW_BOOTSTRAP_WIKI_ON_STARTUP=true
SOULCLAW_BOOTSTRAP_SKILLS_ON_STARTUP=true

# ---- Local paths ----
SOULCLAW_DATA_DIR=./data
SOULCLAW_CONFIG_DIR=./config
SOULCLAW_WORKSPACE_DIR=./workspace
SOULCLAW_WORKSPACE_SEED_DIR=./workspace_seed
SOULCLAW_PACKAGES_DIR=./.packages

# ---- Backing services ----
# Full runtime mode uses Postgres + pgvector. SQLite remains available only
# for tests or an explicitly disabled-vector lightweight fallback.
SOULCLAW_DATABASE_URL=postgresql+psycopg://soulclaw:soulclaw@localhost:5432/soulclaw
SOULCLAW_AGENT_ENGINE=langgraph
SOULCLAW_VECTOR_MODE=required
SOULCLAW_EMBEDDING_MODEL=text-embedding-3-small
SOULCLAW_EMBEDDING_DIMENSIONS=1536
SOULCLAW_EMBEDDING_BATCH_SIZE=32
SOULCLAW_EMBEDDING_PASS_DIMENSIONS=true
# Redis is optional for a single API process. Set required=true when using
# Celery worker/scheduler or a production-style background queue.
SOULCLAW_REDIS_URL=redis://localhost:6379/0
SOULCLAW_REDIS_REQUIRED=false
# Test-only fallback:
# SOULCLAW_DATABASE_URL=sqlite:///data/soulclaw.sqlite3
# SOULCLAW_VECTOR_MODE=disabled

# Host port overrides for Docker Compose when defaults are occupied.
SOULCLAW_HOST_PORT=8020
SOULCLAW_POSTGRES_PORT=5432
SOULCLAW_REDIS_PORT=6379

# ---- Admin console auth ----
SOULCLAW_ADMIN_USERNAME=admin
SOULCLAW_ADMIN_PASSWORD=soulclaw-admin
SOULCLAW_JWT_SECRET=change-me-for-production
SOULCLAW_JWT_ACCESS_TOKEN_MINUTES=720

# ---- OpenAI-compatible LLM ----
# If unset, the runtime still starts and returns retrieval/status answers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
SOULCLAW_LLM_PROVIDER=openai-compatible
SOULCLAW_LLM_CONTEXT_WINDOW_TOKENS=128000

# ---- MCP runtime ----
SOULCLAW_MCP_SEED_ON_STARTUP=true
SOULCLAW_MCP_CONFIG_FILE=config/mcp_servers.yaml
SOULCLAW_MCP_REFRESH_ON_STARTUP=true
SOULCLAW_MCP_DISCOVERY_TIMEOUT_SECONDS=8
SOULCLAW_MCP_CALL_TIMEOUT_SECONDS=60
SOULCLAW_TOOL_SCHEMA_DIRECT_LIMIT=32

# ---- Dream review ----
SOULCLAW_DREAM_REVIEW_ENABLED=true
SOULCLAW_DREAM_REVIEW_CRON=30 3 * * *
SOULCLAW_DREAM_REVIEW_TIMEZONE=Asia/Shanghai
SOULCLAW_DREAM_REVIEW_WINDOW_HOURS=24
SOULCLAW_DREAM_REVIEW_LIMIT=50

# ---- Heartbeat ----
SOULCLAW_HEARTBEAT_ENABLED=true
SOULCLAW_HEARTBEAT_CRON=*/30 * * * *
SOULCLAW_HEARTBEAT_TIMEZONE=Asia/Shanghai
SOULCLAW_GATEWAY_HEARTBEAT_TIMEOUT_SECONDS=120
SOULCLAW_GATEWAY_WEBHOOK_MAX_SKEW_SECONDS=300
SOULCLAW_GATEWAY_WEBHOOK_NONCE_CACHE_SIZE=200

# ---- A2A runtime ----
SOULCLAW_PUBLIC_BASE_URL=
# When true, POST /api/a2a requires Authorization: Bearer <key> or
# X-SoulClaw-A2A-Key even if SOULCLAW_PUBLIC_BASE_URL is empty.
# For unauthenticated local JSON-RPC testing, set this to false explicitly.
SOULCLAW_A2A_REQUIRE_PUBLIC_AUTH=true
SOULCLAW_A2A_PUBLIC_API_KEY=
SOULCLAW_A2A_BOOTSTRAP_SOULSEARCHER_ENABLED=false
SOULCLAW_A2A_SOULSEARCHER_BASE_URL=http://127.0.0.1:8001
SOULCLAW_A2A_SOULSEARCHER_INTERNAL_API_KEY=
SOULCLAW_A2A_SOULSEARCHER_AUTH_USER_HEADER=X-SoulSearcher-User
SOULCLAW_A2A_SOULSEARCHER_USER_ID=soulclaw
SOULCLAW_A2A_POLL_INTERVAL_SECONDS=5
SOULCLAW_A2A_STALLED_TIMEOUT_SECONDS=900
SOULCLAW_A2A_CALLBACK_PUBLIC_URL=
SOULCLAW_A2A_CALLBACK_SECRET=
SOULCLAW_A2A_LIVE_EVENT_IDLE_SECONDS=30
