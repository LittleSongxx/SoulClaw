# ZLAgent local development environment.
# Copy to `.env` and adjust only what you need.

# ---- Server ----
ZLAGENT_APP_NAME=ZLAgent
ZLAGENT_ENVIRONMENT=development
ZLAGENT_HOST=127.0.0.1
ZLAGENT_PORT=8020
ZLAGENT_LOG_LEVEL=INFO
ZLAGENT_AUTO_MIGRATE=true
ZLAGENT_BOOTSTRAP_WIKI_ON_STARTUP=true
ZLAGENT_BOOTSTRAP_SKILLS_ON_STARTUP=true

# ---- Local paths ----
ZLAGENT_DATA_DIR=./data
ZLAGENT_CONFIG_DIR=./config
ZLAGENT_WORKSPACE_DIR=./workspace
ZLAGENT_WORKSPACE_SEED_DIR=./workspace_seed
ZLAGENT_PACKAGES_DIR=./.packages

# ---- Backing services ----
ZLAGENT_DATABASE_URL=sqlite:///data/zlagent.sqlite3
ZLAGENT_REDIS_URL=redis://localhost:6379/0
# Optional production/server DB:
# ZLAGENT_DATABASE_URL=postgresql+psycopg://zlagent:zlagent@localhost:5432/zlagent

# Host port overrides for Docker Compose when defaults are occupied.
ZLAGENT_HOST_PORT=8020
ZLAGENT_POSTGRES_PORT=5432
ZLAGENT_REDIS_PORT=6379

# ---- Admin console auth ----
ZLAGENT_ADMIN_USERNAME=admin
ZLAGENT_ADMIN_PASSWORD=zlagent-admin
ZLAGENT_JWT_SECRET=change-me-for-production
ZLAGENT_JWT_ACCESS_TOKEN_MINUTES=720

# ---- OpenAI-compatible LLM ----
# If unset, the runtime still starts and returns retrieval/status answers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# ---- MCP runtime ----
ZLAGENT_MCP_REFRESH_ON_STARTUP=true
ZLAGENT_MCP_DISCOVERY_TIMEOUT_SECONDS=8
ZLAGENT_MCP_CALL_TIMEOUT_SECONDS=60

# ---- Dream review ----
ZLAGENT_DREAM_REVIEW_ENABLED=true
ZLAGENT_DREAM_REVIEW_CRON=30 3 * * *
ZLAGENT_DREAM_REVIEW_TIMEZONE=Asia/Shanghai
ZLAGENT_DREAM_REVIEW_WINDOW_HOURS=24
ZLAGENT_DREAM_REVIEW_LIMIT=50

# ---- Heartbeat ----
ZLAGENT_HEARTBEAT_ENABLED=true
ZLAGENT_HEARTBEAT_CRON=*/30 * * * *
ZLAGENT_HEARTBEAT_TIMEZONE=Asia/Shanghai
ZLAGENT_GATEWAY_HEARTBEAT_TIMEOUT_SECONDS=120
