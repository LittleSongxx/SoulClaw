# Copy to a private env file and replace every secret before running:
# docker compose --env-file .env.production -f docker-compose.prod.yml up -d

SOULCLAW_ENVIRONMENT=production
SOULCLAW_HOST_PORT=8020
SOULCLAW_LOG_LEVEL=INFO

SOULCLAW_ADMIN_USERNAME=admin
SOULCLAW_ADMIN_PASSWORD=replace-with-a-long-admin-password
SOULCLAW_JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret
SOULCLAW_CORS_ORIGINS=https://soulclaw.example.com
SOULCLAW_PUBLIC_BASE_URL=https://soulclaw.example.com

SOULCLAW_POSTGRES_PASSWORD=replace-with-a-long-postgres-password
SOULCLAW_REDIS_REQUIRED=true
SOULCLAW_A2A_REQUIRE_PUBLIC_AUTH=true
SOULCLAW_A2A_PUBLIC_API_KEY=replace-with-a-random-a2a-public-api-key

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
SOULCLAW_LLM_PROVIDER=openai-compatible
SOULCLAW_LLM_CONTEXT_WINDOW_TOKENS=128000

SOULCLAW_BOOTSTRAP_WIKI_ON_STARTUP=true
SOULCLAW_BOOTSTRAP_SKILLS_ON_STARTUP=true
SOULCLAW_MCP_SEED_ON_STARTUP=true
SOULCLAW_MCP_REFRESH_ON_STARTUP=true
SOULCLAW_DREAM_REVIEW_ENABLED=true
SOULCLAW_DREAM_REVIEW_CRON=30 3 * * *
SOULCLAW_DREAM_REVIEW_TIMEZONE=Asia/Shanghai
SOULCLAW_API_SCHEDULER_ENABLED=false
